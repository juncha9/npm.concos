// concos local SQLite schema — mirror of the resulting shape.
// The record is the migration code in src/modules/store/schema.ts; edit both in the same change.
// Schema version 12 · first required by concos 0.1.11. Every table is a record, not a cache.

Table meta {
  key varchar [pk, note: 'last_seq, last_message_id (schema 9; message numbers are never given twice), created_by_version, created_at, last_opened_by_version, last_migrated_by_version, last_migrated_at, hook_handle_secret (private HMAC key)']
  value varchar [not null]
}

Table workspace {
  id varchar [pk, note: 'ws_ + 10 hex']
  display_path varchar [not null, note: 'absolute path as the agent reported it']
  compare_path varchar [not null, unique, note: 'realpath, or unverified:<path> when unreachable']
  is_verified integer [not null, note: '0 | 1']
  created_at varchar [not null, note: 'ISO 8601 UTC']
}

Table agent {
  id varchar [pk, note: 'agt_ + 10 hex, public']
  room varchar [not null, note: 'fixed to main; one shared room per user database, enforced by triggers']
  handle_hash varchar [not null, unique, note: 'sha256 of the private handle']
  host varchar [note: 'hook host; null for participants created only through MCP']
  host_session_id varchar [note: 'opaque host session id; unique with host']
  display_name varchar [not null]
  client varchar [not null]
  is_human integer [not null, default: 0, note: '1 = person posting from the CLI']
  workspace_id varchar [ref: > workspace.id, note: 'the project of the folder the session started in; a later join from another folder does not change it']
  working_directory varchar [note: 'the folder the session started in: set by its session-start hook or its first join, fixed until the session starts again']
  current_directory varchar [note: 'schema 12: the folder the agent works in now, when it is not working_directory; from check_in or a later join, cleared on leave or when a person takes the card down']
  concos_version varchar [note: 'schema 12: the concos version of the MCP bridge that last joined or kept the card alive; null until a bridge from 0.1.11 on touches it. The board flags a live card whose bridge is older']
  status varchar [not null, default: 'working', note: 'working | waiting | idle | finished']
  role varchar [not null, default: '', note: 'schema 10: the standing role the user gave the agent, set by check_in or by the person at the board; task is what it is doing now']
  task varchar [not null, default: '']
  summary varchar [not null, default: '']
  next_step varchar [not null, default: '']
  blocker varchar [not null, default: '']
  reference_list varchar [not null, default: '[]', note: 'JSON string array']
  editing_list varchar [not null, default: '[]', note: 'JSON string array; cleared on leave and bridge shutdown']
  revision integer [not null, default: 1, note: 'card revision for expected_revision checks']
  changed_seq integer [not null, note: 'meta.last_seq value at the last visible change']
  delivered_seq integer [not null, default: 0, note: 'position delivered by the last check_in']
  hook_nudged_seq integer [not null, default: 0, note: 'newest message seq a turn-end hook or an idle wake has pointed out; each message is pointed out once']
  wake_generation integer [not null, default: 0, note: 'idle wake (Claude Code, Codex): the live watch; a newer watch or a prompt raises it and ends older ones']
  woken_at_list varchar [not null, default: '[]', note: 'JSON array of ISO times this session was woken in the last hour, kept for diagnosis; no hourly limit since 2026-10-26']
  joined_at varchar [not null]
  updated_at varchar [not null, note: 'last card or checkpoint change, not liveness']
  editing_updated_at varchar
  last_seen_at varchar [not null, note: 'bridge heartbeat']
  last_call_at varchar [note: 'last concos tool call or hook event of the agent itself, never the heartbeat; messages wait only on agents that acted within 30 minutes. Schema 7 filled existing cards from updated_at']
  disconnected_at varchar
  left_at varchar

  indexes {
    (host, host_session_id) [unique, name: 'uk_agent_host_session']
    (room, changed_seq) [name: 'idx_agent_room_changed_seq']
    workspace_id [name: 'idx_agent_workspace_id']
  }
}

Table checkpoint {
  id integer [pk]
  agent_id varchar [not null, ref: > agent.id]
  workspace_id varchar [ref: > workspace.id, note: 'workspace at the time of writing']
  body varchar [not null]
  created_at varchar [not null]

  indexes {
    (agent_id, id) [name: 'idx_checkpoint_agent_id_id']
    workspace_id [name: 'idx_checkpoint_workspace_id']
  }
}

Table message {
  id integer [pk, note: 'from meta.last_message_id since schema 9, so a deleted number is never given again']
  seq integer [not null, unique, note: 'from meta.last_seq; orders messages with card changes']
  room varchar [not null, note: 'fixed to main; existing records merged by schema version 3']
  sender_agent_id varchar [not null, ref: > agent.id]
  recipient_agent_id varchar [ref: > agent.id, note: 'the one recipient of a direct message; null for group and all']
  recipient_scope varchar [not null, default: 'direct', note: 'direct | group | all; a group names its recipients through message_receipt; all is a post on the board of its sender, with no receipts. Schema 8 turned direct rows without a recipient, written by older bridges, into all']
  kind varchar [not null, note: 'note | question | reply | notice']
  reply_to_message_id integer [ref: > message.id]
  body varchar [not null]
  workspace_id varchar [ref: > workspace.id]
  request_id varchar [note: 'sender retry key']
  created_at varchar [not null]
  edited_at varchar [note: 'a post its sender rewrote: when; the edit also takes the next seq']

  indexes {
    (sender_agent_id, request_id) [unique, name: 'uk_message_sender_agent_id_request_id']
    (room, seq) [name: 'idx_message_room_seq']
    recipient_agent_id [name: 'idx_message_recipient_agent_id']
    reply_to_message_id [name: 'idx_message_reply_to_message_id']
    workspace_id [name: 'idx_message_workspace_id']
  }

  Note: 'Deleted 24 hours after created_at (a post: after edited_at), read or not; a post beyond the newest 3 of its sender; a message to agents an hour after its last recipient read it, a question only once an answer to it was read an hour ago. A kept reply keeps what it answers.'
}

Table message_receipt {
  message_id integer [not null, ref: > message.id]
  agent_id varchar [not null, ref: > agent.id]
  received_at varchar [note: 'null until acknowledged: once the full text reached the agent (delivered_at), at its next call through any MCP server or when its turn ends; through check_in received_message_ids; or when a person opens it on the board']
  delivered_at varchar [note: 'schema 11: when the full text last went out to the agent in a tool result; kept in the database so an MCP server that restarted before the next call still counts it']

  indexes {
    (message_id, agent_id) [pk]
    (agent_id, received_at) [name: 'idx_message_receipt_agent_id_received_at']
  }

  Note: 'One per named recipient that had not left when the message was sent; posts to all have none. Schema 8 deleted the receipts room-wide messages had.'
}

Table message_topic {
  message_id integer [not null, ref: > message.id]
  topic_key varchar [not null, note: 'snake_case, 2-6 words broad to narrow, 3-48 characters']
  position integer [not null, note: '0 = first topic']

  indexes {
    (message_id, topic_key) [pk]
    topic_key [name: 'idx_message_topic_topic_key']
  }

  Note: 'Up to 3 topics per message, deleted with the message. A topic exists only while a message carries it.'
}
